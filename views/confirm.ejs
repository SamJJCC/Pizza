<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>order confirmation</title>
</head>
<body>
    <h1>Thank you for your order, <%= order.fname %>!</h1>
    <h2>Order Summary</h2>
    <p>
         Name: <%= order.fname %> <%= order.lname %> </p>
        <p> Email: <%= order.email %> </p>
        <p> Pickup or Delivery: <%= order.pickup %> <%= order.delivery %></p>
         <p>Topppings: <%= order.toppings %></p>
         <p>size: <%= order.size %></p>
         <p>comment: <%= order.comment %></p>
        <p> date and time :<%= order.timestamp.toLocaleString() %></p>
    
   
</body>
</html>